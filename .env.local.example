# Copie este arquivo pra .env.local e preencha. Nunca commitar o .env.local de verdade.

# --- Google Sheets (camada de dados temporária, enquanto validamos o modelo) ---
# Criar em https://console.cloud.google.com > IAM & Admin > Service Accounts.
# Cada cliente novo tem sua própria planilha, duplicada do template "Sistema
# M.E.G.A. - Template Zatti" e compartilhada (acesso de Editor) com o e-mail
# dessa mesma service account. O id de cada planilha não é mais uma env var -
# fica cadastrado em `unidades.spreadsheet_id` no Supabase (ver supabase/schema.sql).
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=""

# --- Supabase (login, organizações/unidades/vínculos) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site key publica do Cloudflare Turnstile. A secret key fica somente no
# painel Auth > Bot and Abuse Protection do Supabase, nunca neste repositorio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Chave exclusivamente server-side usada na sugestao assistida de SKU.
ANTHROPIC_API_KEY=
