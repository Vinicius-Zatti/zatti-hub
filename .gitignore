# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase local (gerado por `supabase start`/`db reset` - runtime só
# desta máquina, nunca versionar)
supabase/.temp

# saída da pré-validação de produção (topologia real, nunca versionar -
# só referencia-schema-pre-p0.sql, que é a referência local, é rastreado)
supabase/rollback/producao-schema-atual.sql
supabase/rollback/producao-historico-migrations.txt
supabase/rollback/diff-producao-vs-referencia.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# Zatti Hub
.env.local
.env*.local

.vercel
.env*
